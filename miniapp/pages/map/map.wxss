.page {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
}

.map {
  height: 100vh;
  width: 100vw;
}

.banner {
  position: absolute;
  top: 110rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(11, 92, 255, 0.92);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  z-index: 10;
}

.banner-text {
  font-size: 28rpx;
  color: #fff;
}

.card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 26rpx;
  padding: 22rpx 22rpx 18rpx;
  z-index: 10;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  max-width: 520rpx;
}

.mode-pill {
  background: rgba(255, 255, 255, 0.12);
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.card-sub {
  margin-top: 10rpx;
  opacity: 0.85;
  font-size: 26rpx;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.modal {
  width: 640rpx;
  max-height: 78vh;
  background: #0f0f10;
  border-radius: 26rpx;
  padding: 22rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-body {
  margin-top: 14rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.alt-list {
  margin-top: 18rpx;
  max-height: 42vh;
  overflow: auto;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  padding-top: 12rpx;
}

.alt-item {
  padding: 14rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.alt-title {
  font-size: 30rpx;
}

.alt-sub {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

